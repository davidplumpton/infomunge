%dw 2.0

fun countBy(array, criteria) =
  if (array == null) null
  else sizeOf(array filter (item) -> criteria(item))

fun divideBy(array, size) =
  if (array == null) null
  else if (size <= 0) []
  else if (sizeOf(array) == 0) []
  else [take(array, size)] ++ divideBy(drop(array, size), size)

fun drop(array, amount) = __native("drop", array, amount)
fun dropWhile(array, criteria) = __native("dropWhile", array, criteria)
fun every(array, criteria) = __native("every", array, criteria)

fun firstWith(array, criteria) =
  if (array == null) null
  else first(array filter criteria)

fun indexOf(array, value) =
  using (matches = find(array, value))
    if (sizeOf(matches) == 0) -1 else matches[0]

fun indexWhere(array, criteria) =
  if (array == null) null
  else
    array reduce (item, acc = -1, idx) ->
      if (acc != -1) acc else if (criteria(item)) idx else acc

fun join(left, right, leftKey, rightKey) =
  flatten(
    left map (l) ->
      ((right filter (r) -> leftKey(l) == rightKey(r))
        map (r) -> { l: l, r: r })
  )

fun leftJoin(left, right, leftKey, rightKey) =
  flatten(
    left map (l) ->
      if (sizeOf(right filter (r) -> leftKey(l) == rightKey(r)) == 0)
        [{ l: l, r: null }]
      else
        ((right filter (r) -> leftKey(l) == rightKey(r)) map (r) -> { l: l, r: r })
  )

fun outerJoin(left, right, leftKey, rightKey) = leftJoin(left, right, leftKey, rightKey) ++ ((right filter (r) -> sizeOf(left filter (l) -> leftKey(l) == rightKey(r)) == 0) map (r) -> { l: null, r: r })

fun partition(array, criteria) =
  if (array == null) null
  else
    {
      success: array filter (item) -> criteria(item),
      failure: array filter (item) -> not criteria(item)
    }

fun slice(array, start, end) = __native("slice", array, start, end)
fun some(array, criteria) = __native("some", array, criteria)

fun splitAt(array, index) =
  if (array == null) null
  else
    {
      l: take(array, index),
      r: drop(array, index)
    }

fun splitWhere(array, criteria) =
  if (array == null) null
  else
    {
      l: takeWhile(array, (item) -> not criteria(item)),
      r: dropWhile(array, (item) -> not criteria(item))
    }

fun sumBy(array, mapper) =
  if (array == null) null
  else sum(array map (item) -> mapper(item))

fun take(array, amount) = __native("take", array, amount)
fun takeWhile(array, criteria) = __native("takeWhile", array, criteria)
